Puppy: let PUPPY_BOOTSTRAP_PACKAGES replace the default bootstrap package
list (there is no Puppy package repository yet, so no package manager),
and create profile.d, which the default set happened to create.

diff --git a/scripts/build-bootstraps.sh b/scripts/build-bootstraps.sh
index 53bb59d..88d731e 100755
--- a/scripts/build-bootstraps.sh
+++ b/scripts/build-bootstraps.sh
@@ -219,6 +219,8 @@ add_termux_bootstrap_second_stage_files() {
 	chmod 700 "${BOOTSTRAP_ROOTFS}/${TERMUX_BOOTSTRAP__BOOTSTRAP_SECOND_STAGE_DIR}/$TERMUX_BOOTSTRAP__BOOTSTRAP_SECOND_STAGE_ENTRY_POINT_SUBFILE"
 
 	# TODO: Remove it when Termux app supports `pacman` bootstraps installation.
+	# Puppy: a reduced package set may not create profile.d itself.
+	mkdir -p "${BOOTSTRAP_ROOTFS}/${TERMUX__PREFIX__PROFILE_D_DIR}"
 	sed -e "s|@TERMUX_PREFIX@|${TERMUX_PREFIX}|g" \
 		-e "s|@TERMUX__PREFIX__PROFILE_D_DIR@|${TERMUX__PREFIX__PROFILE_D_DIR}|g" \
 		-e "s|@TERMUX_BOOTSTRAP__BOOTSTRAP_SECOND_STAGE_DIR@|${TERMUX_BOOTSTRAP__BOOTSTRAP_SECOND_STAGE_DIR}|g" \
@@ -464,6 +466,11 @@ main() {
 		PACKAGES+=("patch")
 		PACKAGES+=("unzip")
 
+		# Puppy: an explicit package list replaces the defaults above.
+		if [[ -n "${PUPPY_BOOTSTRAP_PACKAGES:-}" ]]; then
+			read -r -a PACKAGES <<< "$PUPPY_BOOTSTRAP_PACKAGES"
+		fi
+
 		# Handle additional packages.
 		for add_pkg in "${ADDITIONAL_PACKAGES[@]}"; do
 			if [[ " ${PACKAGES[*]} " != *" $add_pkg "* ]]; then
