Puppy: bash without termux-tools. termux-tools (termux-* helper scripts
for the Termux app) pulls termux-am, whose Gradle build needs Google Maven;
Puppy starts its shell and integrates with Android itself.

diff --git a/packages/bash/build.sh b/packages/bash/build.sh
index 4fe660c..a52b795 100644
--- a/packages/bash/build.sh
+++ b/packages/bash/build.sh
@@ -5,7 +5,7 @@ TERMUX_PKG_MAINTAINER="Joshua Kahn <tom@termux.dev>"
 TERMUX_PKG_VERSION=5.3.20
 TERMUX_PKG_SRCURL="https://mirrors.kernel.org/gnu/bash/bash-${TERMUX_PKG_VERSION%.*}.tar.gz"
 TERMUX_PKG_SHA256=0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba
-TERMUX_PKG_DEPENDS="libandroid-support, libiconv, readline (>= 8.3), termux-tools"
+TERMUX_PKG_DEPENDS="libandroid-support, libiconv, readline (>= 8.3)"
 TERMUX_PKG_RECOMMENDS="command-not-found, bash-completion"
 TERMUX_PKG_BREAKS="bash-dev"
 TERMUX_PKG_REPLACES="bash-dev"
